{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miniverso",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "miniverso-auth",
      "database_id": "b1ed2ce7-4faf-4fcf-9f17-f3bdc841fe7b",
      "migrations_dir": "migrations"
    }
  ],
  "account_id": "231635f5bb6788a543029535d773f3a4"
}
